{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "preserveConstEnums": true,
    "declaration": false,
    "noEmit": false
  },
  "include": [".claude/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", ".worktrees", "wiki-workspace", "**/*.test.ts", "**/tests/fixtures/**"]
}
