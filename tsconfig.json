{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "noEmit": false
  },
  "include": [".claude/**/*.ts", "vitest.config.ts"],
  "exclude": [
    "node_modules",
    ".worktrees",
    "wiki-workspace",
    "**/*.test.ts",
    "**/tests/fixtures/**",
    "**/evals/fixtures/**"
  ]
}
